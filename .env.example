# ============================================
# Instagram AI & Gaming Otomasyon - Ortam Değişkenleri
# ============================================
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri girin:
#   copy .env.example .env

# --- Instagram Graph API ---
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here
INSTAGRAM_APP_ID=your_meta_app_id_here
INSTAGRAM_APP_SECRET=your_meta_app_secret_here
# Panel önizlemesinde gösterilen hesap adı (@ olmadan). Sadece görsel —
# Instagram'a gönderilmez. Boşsa "hesabiniz" yer tutucusu gösterilir.
INSTAGRAM_USERNAME=

# --- Marka ---
# Panel başlığında, mobil başlıkta ve dashboard'un HTTP `Server` başlığında
# görünen ad. Boşsa "Instagram News Automation" kullanılır.
# Logolar depoda YOKTUR (kişiye özeldir) — kendi dosyalarınızı
# assets/logos/ altına koyun: logo_horizontal.png ve logo_mark.png.
# Koymazsanız görseller logosuz üretilir, hiçbir şey bozulmaz.
BRAND_NAME=

# ÜRETİLEN GÖRSELE/VİDEOYA basılan hesap etiketi (ör. @hesabiniz).
# Logo dosyası varsa logo basılır; yoksa bu metin basılır.
# Boşsa INSTAGRAM_USERNAME'den türetilir; o da boşsa HİÇBİR ŞEY basılmaz.
# Yanlış bir ad basmaktansa boş bırakmak doğru — bu alan yayınlanan her
# görsele gidiyor.
BRAND_HANDLE=

# --- Görünen metinler ---
# Kategori adları, emojiler ve yedek hashtag'ler config.py > CATEGORIES
# altında (kendi nişinize uyarlarken oraya bakın). Aşağıdaki ikisi
# .env'den de değiştirilebilir; boşsa Türkçe varsayılan kullanılır.
# Reels çıkış slaytındaki çağrı metni:
REELS_CTA_TEXT=
# Hikaye görselinin üst rozeti:
STORY_BADGE_TEXT=

# --- Bot kimliği (RSS kaynaklarına gönderilen User-Agent) ---
# Haber sitelerine kim olduğunuzu söyleyen başlık. Kimliksiz/tarayıcı taklidi
# bir dize WAF'lar tarafından engellenmeye daha yatkındır; +URL sayesinde site
# yöneticisi sizi meşru bir toplayıcı olarak tanıyıp iletişime geçebilir.
# KENDİ kimliğinizi yazın — başkasının alan adıyla tarama yapmayın.
# Boş bırakılırsa proje deposunun adresi kullanılır.
BOT_NAME=
BOT_CONTACT_URL=

# --- News API ---
# NewsAPI.org (https://newsapi.org) - Ücretsiz: 100 istek/gün
NEWS_API_KEY=your_newsapi_key_here

# Currents API (https://currentsapi.services) - Ücretsiz: 600 istek/gün (opsiyonel)
CURRENTS_API_KEY=your_currents_api_key_here

# --- AI / LLM ---
# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM (https://build.nvidia.com) - ücretsiz katalog, opsiyonel.
# DİKKAT: metin üretimi için DEĞİL. 10 Ağustos 2026'da Gemini'nin yerine
# denendi ve geri çekildi (daha yavaş, iki modelde uydurma ölçüldü).
# Burada sadece EMBEDDING için kullanılıyor: (1) haber tekilleştirme,
# (2) görsel-metin alaka kontrolü. Gemini ile yarışmaz, tamamlar.
# Boşsa: bu iki kontrol sessizce devre dışı kalır, sistem çalışmaya devam
# eder ama tekilleştirme sadece SequenceMatcher'a düşer (paraphrase'leri
# kaçırır). Çökme olmaz — bu yüzden eksikliği fark etmek zordur.
NVIDIA_API_KEY=

# --- Stok Fotoğraf (Pexels, opsiyonel) ---
# https://www.pexels.com/api/ - ücretsiz, anında, kredi kartı gerekmez.
# Boşsa görseller mesh-gradient arka plana düşer (sorun olmaz).
PEXELS_API_KEY=your_pexels_api_key_here

# --- Oyun Kapak Görseli (RAWG, opsiyonel) ---
# https://rawg.io/apidocs - ücretsiz, anında, kredi kartı gerekmez.
# Gaming haberleri için Steam'de bulunamayan (konsol-exclusive, henüz
# çıkmamış vb.) oyunların gerçek kapak/ekran görüntüsünü ikinci kademe
# olarak dener (bkz. src/game_cover_art.py). Boşsa bu kademe atlanır,
# doğrudan Pexels/mesh-gradient'e düşülür (sorun olmaz).
RAWG_API_KEY=your_rawg_api_key_here

# --- Medya Hosting (ZORUNLU — Instagram API için public URL gerekir) ---
# Cloudinary (https://cloudinary.com) - Ücretsiz tier bu hacim için yeterli.
# Bu üçü doluysa medya otomatik olarak Cloudinary'ye yüklenir.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
# Cloudinary'de hangi klasöre yüklensin (opsiyonel)
CLOUDINARY_UPLOAD_FOLDER=instagram_otomasyon

# MEDIA_HOST_URL (opsiyonel/legacy): Cloudinary yapılandırılmamışsa ve kendi
# statik medya sunucunuz varsa (output/ dizinini public serve ediyorsanız)
# bu URL + dosya adı birleştirilerek kullanılır. Cloudinary önerilir.
MEDIA_HOST_URL=

# --- Uygulama Ayarları ---
# İçerik dili (tr / en / both)
CONTENT_LANGUAGE=tr

# Dashboard portu
DASHBOARD_PORT=5000

# Dashboard giriş şifresi — boş bırakılırsa giriş ekranı devre dışı kalır
# (yerelde sorun değil). Paneli bir VDS'e taşıyıp internete açmadan ÖNCE
# mutlaka doldurun, yoksa link'i bilen herkes paylaşımlarınızı yönetebilir.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Oturum imzalama anahtarı — üretmek için:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Boş bırakılırsa her yeniden başlatmada oturumlar düşer (yerelde sorun değil).
DASHBOARD_SECRET_KEY=

# Log seviyesi (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# Günlük paylaşım limitleri
DAILY_POST_LIMIT=2
DAILY_STORY_LIMIT=5
DAILY_REELS_LIMIT=1

# --- Bakım: yedekleme, retention, disk (hepsi opsiyonel) ---
# Her gece 02:00'de çalışan günlük bakım işini ayarlar. Boş bırakılırsa
# aşağıdaki varsayılanlar kullanılır. Ayrıntı için README > "Bakım,
# yedekleme ve disk".
#
# Veritabanı yedeklerinin saklanma süresi (gün)
BACKUP_RETENTION_DAYS=14
# output/ altındaki üretilmiş medyanın diskte kalma süresi (gün).
# UYARI: bu temizlik olmadan output/ günde ~540 MB büyüyor ve disk dolduğunda
# tüm servisler durur.
MEDIA_RETENTION_DAYS=14
# İndirilen görsel önbelleklerinin ömrü (gün) — silinirse yeniden indirilir
CACHE_RETENTION_DAYS=30
# Disk bu yüzdeyi aşarsa sağlık kontrolü Telegram'dan uyarır
DISK_USAGE_WARN_PERCENT=80
# İşlenmemiş haber kaç gün sonra kuyruktan düşürülsün.
# Toplama işlemeden hızlı olduğu için en eski haberler asla sıraya gelmiyor;
# bu olmadan kuyruk sonsuza kadar büyür (ölçüm: +45 haber/gün).
UNPROCESSED_NEWS_EXPIRY_DAYS=2

# --- Günlük derleme (kaydırmalı özet gönderi) ---
# Kapsamı feed gönderisi sayısını artırmadan büyütür: tek slotta 6 haber.
# Üretilmiş taslaklardan kurulduğu için ek Gemini maliyeti yoktur.
ROUNDUP_ENABLED=true
ROUNDUP_ITEM_COUNT=6
ROUNDUP_MIN_ITEMS=4
ROUNDUP_TIME=18:30

# --- MCP Sunucusu (Gemini Spark / harici araştırma köprüsü, opsiyonel) ---
# python main.py --mcp-server ile çalıştırılır, Cloudflare Tunnel ile dışa açılır.
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
# Uzun rastgele bir dize üretin: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SHARED_SECRET=

# --- Harici Araştırma API'si (opsiyonel) ---
# Dashboard'daki /api/research/submit uç noktasını koruyan AYRI token.
# Neden MCP_SHARED_SECRET'tan ayrı: claude.ai "Routines" özel MCP
# connector'larını desteklemiyor, bu yüzden zamanlanmış araştırma ajanları
# için sınırlı yetkili ayrı bir REST ucu var.
# Boşsa: uç nokta 503 döner, sistemin geri kalanı etkilenmez.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESEARCH_API_TOKEN=

# --- Telegram Onay Botu (opsiyonel) ---
# @BotFather ile /newbot yazıp token alın. chat_id'yi scripts/get_telegram_chat_id.py ile öğrenin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# "auto": relevance_score eşiğini geçen içerik otomatik yayınlanır.
# "telegram": hiçbir içerik otomatik yayınlanmaz, hepsi için Telegram'dan onay istenir.
APPROVAL_MODE=telegram

# --- Diğer ince ayarlar ---
# Yukarıda olmayan 26 ayar daha var (eşikler, saklama günleri, log rotasyonu,
# sağlık kontrolü zamanları, Telegram hatırlatma aralıkları…). Hepsi
# config.py içinde VARSAYILANIYLA tanımlı; sır değil, eksik olunca hiçbir
# özellik kapanmıyor. Değiştirmek isterseniz config.py'deki adıyla buraya
# yazın — .env, config'teki varsayılanı ezer. Bilerek buraya kopyalanmadılar:
# 47 anahtarlık örnek dosyayı iki katına çıkarıp asıl gerekenleri gömerlerdi.
